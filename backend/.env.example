NODE_ENV=development
PORT=5000
# Use your existing database name on a replica set. Never point tests at this URI.
MONGODB_URI=mongodb://127.0.0.1:27017/lms-college?replicaSet=rs0
JWT_ACCESS_SECRET=replace_with_a_unique_random_access_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_refresh_secret_at_least_32_characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:3000
DB_POOL_SIZE=30
# Optional process-local DNS override if network DNS cannot resolve Atlas SRV records.
# Leave blank to use system DNS. For public Atlas hosts: 1.1.1.1,8.8.8.8
MONGODB_DNS_SERVERS=
TRUST_PROXY_HOPS=0
# Optional for private attachments; blank values make uploads unavailable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional AI question assistance; ordinary assessments do not require it.
GEMINI_API_KEY=
